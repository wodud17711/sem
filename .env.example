# 운영 도메인 (운영: https://sem.kr / 로컬 개발: http://localhost:3000)
# Vercel 환경변수에 운영 값을 등록. 빈 값일 때 코드 fallback은 https://sem.kr
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX). Phase 4-2에서 입력
NEXT_PUBLIC_GA_ID=

# Google Search Console 도메인 소유 확인 코드 (meta 태그 content 값)
# Search Console에서 'HTML 태그' 방식 선택 시 발급되는 문자열
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# 네이버 서치어드바이저 사이트 소유 확인 코드 (meta 태그 content 값)
NEXT_PUBLIC_NAVER_VERIFICATION=

# Google AdSense 게시자 ID (예: ca-pub-XXXXXXXXXXXXXXXX). Phase 5-3 승인 후 입력
NEXT_PUBLIC_ADSENSE_ID=
